const sections=document.getElementById('sections');
function renderCollections(){
 sections.innerHTML=collections.map(c=>`<section class="category-section" id="${c.id}"><div class="section-head"><div class="section-title"><div class="section-icon"><i class="fa-solid ${c.icon}"></i></div><div><h2>${c.title}</h2><p>${c.subtitle}</p></div></div><div class="scroll-buttons"><button class="scroll-btn" onclick="moveRow('${c.row}',-1)" aria-label="Scroll ${c.title} left" title="Scroll left"><i class="fa-solid fa-chevron-left"></i></button><button class="scroll-btn" onclick="moveRow('${c.row}',1)" aria-label="Scroll ${c.title} right" title="Scroll right"><i class="fa-solid fa-chevron-right"></i></button></div></div><div class="product-row" id="${c.row}" tabindex="0" role="region" aria-label="${c.title} products. Use left and right arrow keys to scroll.">${c.items.map((p,i)=>cardHTML(c,p,i)).join('')}</div></section>`).join('');
 setupRows();
}
function cardHTML(c,p,i){const [name,file,icon,price,desc]=p;return `<article class="product-card" data-name="${name}" data-category="${c.category}"><div class="product-image"><span class="badge">${c.badge}</span><img src="images/${file}" alt="${name}" loading="lazy" onerror="imageFallback(this,'${icon}')"><i class="product-placeholder fa-solid ${icon}"></i></div><div class="product-info"><div class="product-category">${c.category}</div><h3>${name}</h3><p>${desc}</p><div class="product-bottom"><span class="price">₹${price}</span><div class="card-actions"><button class="card-btn" onclick="viewProduct(this)" aria-label="View ${name}" title="View details"><i class="fa-regular fa-eye"></i></button><button class="card-btn add" onclick="addProduct(this)" aria-label="Add ${name} to cart" title="Add to cart"><i class="fa-solid fa-cart-plus"></i></button></div></div></div></article>`}
function imageFallback(img,iconName){img.style.display='none';const icon=img.nextElementSibling;if(icon){icon.className='product-placeholder fa-solid '+iconName;icon.style.display='block'}}
let activeRow=null;
function moveRow(id,direction){const row=document.getElementById(id);if(!row)return;activeRow=row;row.focus({preventScroll:true});row.scrollBy({left:direction*Math.max(250,row.clientWidth*.8),behavior:'smooth'})}
function setupRows(){document.querySelectorAll('.product-row').forEach(row=>{
 row.addEventListener('focus',()=>activeRow=row);row.addEventListener('pointerdown',()=>activeRow=row);
 let down=false,startX=0,startScroll=0,didDrag=false,pointerId=null;
 row.addEventListener('pointerdown',e=>{if(e.pointerType==='mouse'&&e.button!==0)return;if(e.target.closest('button'))return;down=true;didDrag=false;startX=e.clientX;startScroll=row.scrollLeft;pointerId=e.pointerId;activeRow=row;if(e.pointerType==='mouse')row.classList.add('dragging')});
 row.addEventListener('pointermove',e=>{if(!down)return;const dx=e.clientX-startX;if(Math.abs(dx)>5)didDrag=true;if(didDrag)row.scrollLeft=startScroll-dx});
 const endDrag=()=>{down=false;row.classList.remove('dragging');if(pointerId!==null){pointerId=null}if(didDrag)setTimeout(()=>didDrag=false,80)};
 row.addEventListener('pointerup',endDrag);row.addEventListener('pointercancel',endDrag);row.addEventListener('pointerleave',()=>{if(down)endDrag()});
 row.addEventListener('click',e=>{if(didDrag){e.preventDefault();e.stopPropagation();didDrag=false}},true);
 row.addEventListener('wheel',e=>{if(Math.abs(e.deltaY)>Math.abs(e.deltaX)&&row.scrollWidth>row.clientWidth){row.scrollLeft+=e.deltaY;e.preventDefault()}},{passive:false});
 });}
document.addEventListener('keydown',e=>{if(e.key==='Escape'){closeModal();return}if(e.key!=='ArrowLeft'&&e.key!=='ArrowRight')return;if(document.getElementById('productModal').classList.contains('show'))return;const el=document.activeElement;if(el&&(el.matches('input,textarea,select')||el.isContentEditable))return;let row=el?.closest?.('.product-row')||activeRow;if(!row)return;e.preventDefault();row.scrollBy({left:(e.key==='ArrowRight'?1:-1)*Math.max(100,row.clientWidth*.35),behavior:'smooth'});activeRow=row});
function searchProducts(){const q=document.getElementById('searchInput').value.toLowerCase().trim();document.querySelectorAll('.product-card').forEach(card=>{card.style.display=(card.textContent.toLowerCase().includes(q)||card.dataset.name.toLowerCase().includes(q))?'':'none'});document.querySelectorAll('.category-section').forEach(section=>{section.style.display=[...section.querySelectorAll('.product-card')].some(card=>card.style.display!=='none')?'':'none'})}
let selectedProduct=null;let toastTimer;
function getProduct(card){return{name:card.dataset.name,category:card.dataset.category,price:card.querySelector('.price').textContent,description:card.querySelector('.product-info p').textContent}}
function viewProduct(button){selectedProduct=getProduct(button.closest('.product-card'));document.getElementById('modalName').textContent=selectedProduct.name;document.getElementById('modalCategory').textContent=selectedProduct.category;document.getElementById('modalPrice').textContent=selectedProduct.price;document.getElementById('modalDescription').textContent=selectedProduct.description;document.getElementById('productModal').classList.add('show');document.body.style.overflow='hidden'}
function closeModal(){document.getElementById('productModal').classList.remove('show');document.body.style.overflow=''}function closeOutside(e){if(e.target.id==='productModal')closeModal()}function addProduct(button){saveCart(getProduct(button.closest('.product-card')))}function addModalProduct(){if(selectedProduct){saveCart(selectedProduct);closeModal()}}
function saveCart(product){let cart=[];try{cart=JSON.parse(localStorage.getItem('medicareCart'))||[]}catch(e){cart=[]}const existing=cart.find(item=>item.name===product.name);if(existing)existing.quantity=(Number(existing.quantity)||1)+1;else cart.push({name:product.name,category:product.category,price:product.price,quantity:1});localStorage.setItem('medicareCart',JSON.stringify(cart));showToast(product.name+' added to cart!')}
function showToast(message){const toast=document.getElementById('toast');toast.textContent=message;toast.classList.add('show');clearTimeout(toastTimer);toastTimer=setTimeout(()=>toast.classList.remove('show'),2300)}
renderCollections();
</script>
</body></html>
