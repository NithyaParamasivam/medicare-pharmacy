/* =========================================================
   RENDER PRODUCTS
========================================================= */

const productsContainer =
    document.getElementById("productsContainer");


function renderProducts(searchText = ""){

    productsContainer.innerHTML = "";

    let foundAny = false;

    categories.forEach((category) => {

        const filteredProducts =
            category.products.filter(product => {

                const text = (

                    product.name + " " +
                    product.type + " " +
                    product.category + " " +
                    product.purpose + " " +
                    product.uses + " " +
                    product.symptoms

                ).toLowerCase();

                return text.includes(searchText.toLowerCase());

            });


        if(filteredProducts.length === 0){
            return;
        }

        foundAny = true;


        const section =
            document.createElement("section");

        section.className = "medicine-section";


        section.innerHTML = `

            <div class="section-heading">

                <h2>
                    ${category.icon} ${category.title}
                </h2>

                <p>
                    ${category.description}
                </p>

            </div>

            <div class="products"></div>

        `;


        const productsDiv =
            section.querySelector(".products");

        productsDiv.tabIndex = 0;
        productsDiv.setAttribute("aria-label", `${category.title} products`);


        filteredProducts.forEach((product,index) => {

            const card =
                document.createElement("div");

            card.className = "product-card";

            card.style.animationDelay =
                `${index * 0.05}s`;


            card.innerHTML = `

                <div class="product-image">

                    <img
                        src="${product.image}"
                        alt="${product.name}"
                        onerror="this.onerror=null;this.src='images/medbg.jpg';"
                    >

                </div>

                <div class="product-info">

                    <h3>
                        ${product.name}
                    </h3>

                    <span class="product-type">
                        ${product.type}
                    </span>

                    <p>
                        ${product.purpose}
                    </p>

                    <div class="product-bottom">

                        <span class="price">
                            ₹${product.price}
                        </span>

                        <span class="rating">
                            ⭐ ${product.rating}
                        </span>

                    </div>

                    <div class="product-actions">

                        <button class="view-btn" type="button">
                            👁️ View
                        </button>

                        <button class="card-cart-btn" type="button">
                            🛒 Add Cart
                        </button>

                    </div>

                </div>

            `;

            const viewBtn =
                card.querySelector(".view-btn");

            const cardCartBtn =
                card.querySelector(".card-cart-btn");

            viewBtn.addEventListener("click", (event) => {

                event.stopPropagation();
                openMedicine(product);

            });

            cardCartBtn.addEventListener("click", (event) => {

                event.stopPropagation();
                addProductToCart(product, cardCartBtn);

            });

            card.addEventListener("click", () => {

                openMedicine(product);

            });


            productsDiv.appendChild(card);

        });


        productsContainer.appendChild(section);

        enableHorizontalProductScroll(productsDiv);

    });


    if(!foundAny){

        productsContainer.innerHTML = `

            <div class="no-result">

                <h2>🔎 No medicine found</h2>

                <p>
                    Try another medicine name or category.
                </p>

            </div>

        `;

    }

}


