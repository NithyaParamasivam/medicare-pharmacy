}

body{
    font-family:"Manrope",sans-serif;
    background:#f7f9fc;
    color:#17202a;
}

/* ================= NAVBAR ================= */

nav{
    position:sticky;
    top:0;
    z-index:1000;

    display:flex;
    align-items:center;
    justify-content:space-between;

    padding:15px 6%;

    background:rgba(255,255,255,0.94);
    backdrop-filter:blur(14px);

    box-shadow:0 5px 25px rgba(0,0,0,0.08);
}

.logo{
    font-size:25px;
    font-weight:800;
    color:#087f8c;
}

.logo span{
    color:#19a974;
}

nav ul{
    list-style:none;
    display:flex;
    gap:25px;
}

nav ul li a{
    text-decoration:none;
    color:#263238;
    font-weight:700;
    transition:.3s;
}

nav ul li a:hover{
    color:#08a88a;
}

/* ================= HERO ================= */

.hero{
    min-height:380px;

    display:flex;
    flex-direction:column;
    justify-content:center;
    align-items:center;
    text-align:center;

    padding:50px 20px;

    background:
        linear-gradient(
            rgba(0,90,100,.78),
            rgba(0,120,100,.65)
        ),
        url("images/medbg.jpg");

    background-size:cover;
    background-position:center;

    color:white;
}

.hero h1{
    font-family:"DM Serif Display",serif;
    font-size:55px;
    letter-spacing:.5px;
    margin-bottom:15px;

    animation:heroDown .8s ease;
}

.hero p{
    max-width:700px;
    font-size:18px;
    line-height:1.7;

    animation:heroUp 1s ease;
}

.hero-symbol{
    font-size:48px;
    margin-bottom:10px;
    animation:floatIcon 3s ease-in-out infinite;
}

@keyframes heroDown{
    from{
        opacity:0;
        transform:translateY(-30px);
    }
    to{
        opacity:1;
        transform:translateY(0);
    }
}

@keyframes heroUp{
    from{
        opacity:0;
        transform:translateY(30px);
    }
    to{
        opacity:1;
        transform:translateY(0);
    }
}

@keyframes floatIcon{
    0%,100%{
        transform:translateY(0);
    }
    50%{
        transform:translateY(-8px);
    }
}

/* ================= SEARCH ================= */

.search-box{
    width:min(700px,90%);
    margin:-30px auto 45px;
    position:relative;
    z-index:10;
}

.search-box input{
    width:100%;
    padding:18px 25px;

    border:none;
    outline:none;

    border-radius:50px;

    background:white;

    box-shadow:0 12px 35px rgba(0,0,0,.14);

    font-size:16px;
    font-family:inherit;
}

.search-box input:focus{
    box-shadow:0 12px 35px rgba(0,150,130,.22);
}

/* ================= SECTIONS ================= */

#productsContainer{
    width:100%;
}

.medicine-section{
    width:100%;
    padding:70px 5%;
    position:relative;
    overflow:hidden;

    background:
        linear-gradient(
            135deg,
            rgba(232,250,247,.9),
            rgba(248,252,255,.96)
        );

    border-top:1px solid rgba(0,0,0,.04);
}

.medicine-section:nth-child(even){
    background:
        linear-gradient(
            135deg,
            rgba(239,247,255,.95),
            rgba(246,253,249,.98)
        );
}

.medicine-section::before{
    content:"";
    position:absolute;

    width:260px;
    height:260px;

    border-radius:50%;

    background:rgba(25,169,116,.07);

    top:-100px;
    right:-70px;
}

.section-heading{
    position:relative;
    z-index:2;

    max-width:1150px;
    margin:0 auto 35px;
}

.section-heading h2{
    font-family:"DM Serif Display",serif;
    font-size:38px;
    color:#087f8c;
}

.section-heading p{
    margin-top:8px;
    color:#65727c;
    max-width:700px;
    line-height:1.6;
}

/* ================= PRODUCTS ================= */

.products{
    width:100%;
    max-width:1150px;
    margin:auto;

    display:flex;
    flex-direction:row;
    flex-wrap:nowrap;
    align-items:stretch;
    gap:24px;

    overflow-x:auto;
    overflow-y:hidden;

    padding:8px 6px 25px;

    scroll-behavior:smooth;
    scroll-snap-type:x proximity;
    -webkit-overflow-scrolling:touch;

    cursor:grab;
    user-select:none;
    touch-action:pan-x;

    scrollbar-width:thin;
}

.products:active{
    cursor:grabbing;
}

.products.is-dragging{
    cursor:grabbing;
}

.products::-webkit-scrollbar{
    height:8px;
}

.products::-webkit-scrollbar-track{
    background:rgba(8,127,140,.08);
    border-radius:20px;
}

.products::-webkit-scrollbar-thumb{
    background:rgba(8,127,140,.45);
    border-radius:20px;
}

.products:focus-visible{
    outline:3px solid rgba(8,127,140,.25);
    outline-offset:4px;
}


.product-card{
    flex:0 0 250px;
    width:250px;
    min-width:250px;

    background:white;
    border-radius:22px;

    overflow:hidden;

    box-shadow:0 8px 28px rgba(0,0,0,.08);

    transition:
        transform .35s ease,
        box-shadow .35s ease;

    cursor:pointer;

    animation:cardShow .6s ease both;
}

.product-card:hover{
    transform:translateY(-9px);
    box-shadow:0 18px 40px rgba(0,100,100,.18);
}

@keyframes cardShow{
    from{
        opacity:0;
        transform:translateY(25px);
    }
    to{
        opacity:1;
        transform:translateY(0);
    }
}

.product-image{
    height:190px;
    width:100%;
    overflow:hidden;
    background:#eef5f5;
}

.product-image img{
    width:100%;
    height:100%;

    object-fit:cover;

    transition:transform .5s ease;
}

.product-card:hover .product-image img{
    transform:scale(1.08);
}

.product-info{
    padding:18px;
}

.product-info h3{
    font-size:18px;
    margin-bottom:7px;
    color:#17202a;
}

.product-type{
    display:inline-block;

    padding:5px 10px;

    background:#e5f8f4;
    color:#078d7d;

    border-radius:20px;

    font-size:12px;
    font-weight:800;
}

.product-info p{
    color:#65727c;
    font-size:13px;
    line-height:1.5;
    margin:10px 0;
}

.product-bottom{
    display:flex;
    justify-content:space-between;
    align-items:center;
}

.price{
    color:#087f8c;
    font-size:18px;
    font-weight:800;
}

 .rating{
    font-size:13px;
    color:#e69b00;
}

.product-actions{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:10px;
    margin-top:15px;
}

.view-btn,
.card-cart-btn{
    border:none;
    border-radius:12px;
    padding:11px 8px;
    font-family:inherit;
    font-size:13px;
    font-weight:800;
    cursor:pointer;
    transition:.3s;
}

.view-btn{
    background:#e9f7f6;
    color:#087f8c;
}

.view-btn:hover{
    background:#d5f0ed;
    transform:translateY(-2px);
}

.card-cart-btn{
    background:linear-gradient(135deg,#087f8c,#19a974);
    color:white;
}

.card-cart-btn:hover{
    transform:translateY(-2px);
    box-shadow:0 8px 18px rgba(8,127,140,.22);
}

.card-cart-btn.added{
    background:#19a974;
}

/* ================= MODAL ================= */

.modal{
    display:none;

    position:fixed;
    inset:0;

    z-index:2000;

    background:rgba(8,20,25,.72);

    backdrop-filter:blur(8px);

    justify-content:center;
    align-items:center;

    padding:20px;
}

.modal.active{
    display:flex;
    animation:modalBg .25s ease;
}

@keyframes modalBg{
    from{opacity:0;}
    to{opacity:1;}
}

.modal-content{
    width:min(950px,100%);
    max-height:92vh;

    overflow-y:auto;

    background:white;

    border-radius:25px;

    position:relative;

    box-shadow:0 30px 80px rgba(0,0,0,.3);

    animation:modalOpen .35s ease;
}

@keyframes modalOpen{
    from{
        opacity:0;
        transform:scale(.9) translateY(20px);
    }
    to{
        opacity:1;
        transform:scale(1) translateY(0);
    }
}

.close{
    position:absolute;
    right:18px;
    top:15px;

    width:40px;
    height:40px;

    border:none;
    border-radius:50%;

    background:white;

    font-size:25px;

    cursor:pointer;

    z-index:5;

    box-shadow:0 4px 15px rgba(0,0,0,.15);
}

.close:hover{
    background:#eaf8f5;
}

.modal-top{
    display:grid;
    grid-template-columns:42% 58%;
}

.modal-image{
    min-height:420px;
    background:#eef5f5;
