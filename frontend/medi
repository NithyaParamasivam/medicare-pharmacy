/* =========================================================
   ADD PRODUCT TO CART
========================================================= */

function addProductToCart(product, button = null){

    let cart =
        JSON.parse(
            localStorage.getItem("medicareCart")
        ) || [];

    const existing =
        cart.find(
            item => item.name === product.name
        );

    if(existing){

        existing.quantity =
            (existing.quantity || 1) + 1;

    }
    else{

        cart.push({

            name:product.name,
            price:product.price,
            image:product.image,
            type:product.type,
            quantity:1

        });

    }

    localStorage.setItem(
        "medicareCart",
        JSON.stringify(cart)
    );

    if(button){

        const oldText = button.innerHTML;

        button.innerHTML = "✅ Added";
        button.classList.add("added");

        setTimeout(() => {

            button.innerHTML = oldText;
            button.classList.remove("added");

        },1500);

    }
}


/* =========================================================
   HORIZONTAL PRODUCT SCROLL
========================================================= */

function enableHorizontalProductScroll(scroller){

    let isDragging = false;
    let startX = 0;
    let startScrollLeft = 0;
    let moved = false;

    scroller.addEventListener("pointerdown", (event) => {

        if(event.pointerType === "mouse" && event.button !== 0){
            return;
        }

        isDragging = true;
        moved = false;
        startX = event.clientX;
        startScrollLeft = scroller.scrollLeft;

        scroller.classList.add("is-dragging");
        scroller.setPointerCapture(event.pointerId);

    });

    scroller.addEventListener("pointermove", (event) => {

        if(!isDragging){
            return;
        }

        const distance = event.clientX - startX;

        if(Math.abs(distance) > 4){
            moved = true;
        }

        scroller.scrollLeft =
            startScrollLeft - distance;

    });

    const stopDragging = (event) => {

        if(!isDragging){
            return;
        }

        isDragging = false;
        scroller.classList.remove("is-dragging");

        if(event && scroller.hasPointerCapture(event.pointerId)){
            scroller.releasePointerCapture(event.pointerId);
        }

        if(moved){

            scroller.dataset.justDragged = "true";

            setTimeout(() => {
                scroller.dataset.justDragged = "false";
            },80);

        }

    };

    scroller.addEventListener("pointerup", stopDragging);
    scroller.addEventListener("pointercancel", stopDragging);

    scroller.addEventListener("lostpointercapture", () => {
        isDragging = false;
        scroller.classList.remove("is-dragging");
    });

    scroller.addEventListener("wheel", (event) => {

        if(event.shiftKey && Math.abs(event.deltaY) > 0){

            event.preventDefault();
            scroller.scrollLeft += event.deltaY;

        }

    }, {passive:false});

    scroller.addEventListener("keydown", (event) => {

        if(event.key === "ArrowRight"){
            event.preventDefault();
            scroller.scrollBy({left:274, behavior:"smooth"});
        }

        if(event.key === "ArrowLeft"){
            event.preventDefault();
            scroller.scrollBy({left:-274, behavior:"smooth"});
        }

        if(event.key === "Home"){
            event.preventDefault();
            scroller.scrollTo({left:0, behavior:"smooth"});
        }

        if(event.key === "End"){
            event.preventDefault();
            scroller.scrollTo({
                left:scroller.scrollWidth,
                behavior:"smooth"
            });
        }

    });

    scroller.addEventListener("click", (event) => {

        if(scroller.dataset.justDragged === "true"){

            event.preventDefault();
            event.stopPropagation();
            scroller.dataset.justDragged = "false";

        }

    }, true);

}


