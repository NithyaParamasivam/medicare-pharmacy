    .section-heading h2{
        font-size:31px;
    }

    .products{
        gap:16px;
        padding-bottom:20px;
    }

    .product-card{
        flex-basis:230px;
        width:230px;
        min-width:230px;
    }

    .modal-top{
        grid-template-columns:1fr;
    }

    .modal-image{
        min-height:250px;
        height:250px;
    }

    .modal-image img{
        min-height:250px;
    }

    .modal-details{
        padding:25px;
    }

    .info-grid{
        grid-template-columns:1fr;
    }
}

</style>
